# LexiLoop 环境变量示例
# 用法：复制为 .env（.env 已被 .gitignore 排除，永不入库）后按需修改。
# 本应用是「纯静态前端 + Python 标准库静态服务器」，只需要一个环境变量：

# server.py 监听端口（默认 3000，绑定 0.0.0.0）
PORT=3000

# ------------------------------------------------------------
# 以下为说明，无需填写：
#
# 1. 云服务配置（endpoint 与 publishableKey）在 lexiloop/js/config.js。
#    publishableKey 是设计上公开的前端发布键（wbpk_ 前缀），只标识
#    「是哪个应用」，不含任何权限（服务端按 Origin 精确校验），可安全提交。
#    切勿把任何长期密钥写进前端代码或本文件。
#
# 2. 「自带 LLM API Key」是应用内的可选功能，Key 只存用户浏览器
#    localStorage（键名 lexiloop.customapi.v1），不经过服务端、不进本仓库。
# ------------------------------------------------------------


# 可选：历史端到端脚本的隔离测试账号。留空，不提交真实凭据。
# 脚本不会自动加载 .env；请在执行环境显式设置这两个变量。
LEXILOOP_TEST_EMAIL=
LEXILOOP_TEST_PASSWORD=
